# Environment for the signage service. Copy to /etc/signage/signage.env
# (root-only, chmod 600). deploy/install.sh creates it for you with a
# generated password if it does not exist.

# Required to protect the dashboard. TVs never need it.
ADMIN_PASSWORD=change-me

# Set this when the server is reachable from the internet, e.g. through a
# Cloudflare Tunnel. It is printed at startup and makes ADMIN_PASSWORD
# mandatory: the server refuses to start exposed without a password.
#PUBLIC_URL=https://signage.example.com

# Optional. Logins are signed with a key derived from ADMIN_PASSWORD, so
# they survive restarts. Set this to sign with something else, e.g. to log
# everyone out without changing the password.
#SESSION_SECRET=

# Optional. Largest upload the dashboard allows when reached through the
# tunnel, matching Cloudflare's per-request body limit (100 MB on Free).
#TUNNEL_UPLOAD_LIMIT_MB=100

# Optional. Where db.json and uploaded media live. Defaults to ./data.
#DATA_DIR=/opt/signage/data

# Optional. Which peer's X-Forwarded-* headers to believe (Express "trust proxy"
# value). Defaults to loopback, where deploy/install-tunnel.sh runs cloudflared.
# Set to the connector's address if it runs on another machine.
#TRUSTED_PROXY=loopback

# Optional. Defaults to 0.0.0.0 so the LAN address keeps working. A tunnel-only
# server can bind to loopback instead: nothing on the LAN can reach it then.
#BIND_ADDRESS=127.0.0.1
