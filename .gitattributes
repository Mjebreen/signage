# Shell scripts and unit files must reach a Linux server with LF endings, whatever
# machine they were edited on; a CRLF here makes bash fail with "$'': command not found".
* text=auto
*.sh text eol=lf
*.service text eol=lf
*.env.example text eol=lf
Dockerfile text eol=lf
*.yml text eol=lf
*.bat text eol=crlf
